{
  "name": "shixu-workbench-template",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "demo": "npm run build:web && node demo/server.mjs",
    "demo:serve": "node demo/server.mjs",
    "build:web": "vite build --config cloud/vite.config.ts",
    "build:api": "node scripts/build-functions.mjs",
    "build": "npm run build:web && npm run build:api",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@casl/ability": "7.1.3",
    "@cloudbase/node-sdk": "3.18.7",
    "driver.js": "1.14.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "9.3.15",
    "recharts": "3.8.0",
    "tesseract.js": "7.0.0",
    "xstate": "5.33.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
